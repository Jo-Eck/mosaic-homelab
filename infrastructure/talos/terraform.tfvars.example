# Copy to terraform.tfvars and adjust. Keep versions mutually compatible and in
# sync with infrastructure/proxmox + .mise.toml.
#   cp terraform.tfvars.example terraform.tfvars

talos_version      = "v1.13.7"
kubernetes_version = "v1.32.3"

network_cidr    = "24"
network_gateway = "192.168.8.1"
nameservers     = ["192.168.8.1"]
install_disk    = "/dev/sda"
