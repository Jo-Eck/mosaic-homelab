# -------------------------------------------------------------------------
# Copy to secrets.sops.yaml, fill in real values, then ENCRYPT IN PLACE:
#   cp secrets.sops.yaml.example secrets.sops.yaml
#   sops --encrypt --in-place secrets.sops.yaml
#
# The encrypted secrets.sops.yaml is safe to commit. NEVER commit plaintext.
# -------------------------------------------------------------------------

# Proxmox API token, format: USER@REALM!TOKENID=SECRET
# Create it in PVE: Datacenter > Permissions > API Tokens (give it a role that
# can manage VMs/storage; uncheck "Privilege Separation" or grant a role).
proxmox_api_token: "tofu@pve!mosaic=REPLACE-WITH-TOKEN-UUID"
