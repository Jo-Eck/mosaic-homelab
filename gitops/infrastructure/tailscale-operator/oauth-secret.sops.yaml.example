# EXAMPLE — do NOT commit real credentials in plaintext.
#
# The Tailscale operator authenticates with an OAuth client. Create one in the
# Tailscale admin console (Settings -> OAuth clients) with the `Devices Core`
# and `Auth Keys` write scopes, and tag it (e.g. tag:k8s-operator). Then:
#
#   cp oauth-secret.sops.yaml.example oauth-secret.sops.yaml
#   # paste client_id / client_secret below
#   sops --encrypt --in-place oauth-secret.sops.yaml     # cluster age key, per .sops.yaml
#   # then add `- oauth-secret.sops.yaml` to kustomization.yaml
#
# Flux decrypts it in-cluster (flux-system/sops-age). The keys MUST be named
# client_id and client_secret (that's what the operator reads).
apiVersion: v1
kind: Secret
metadata:
  name: operator-oauth
  namespace: tailscale
type: Opaque
stringData:
  client_id: "tskey-client-REPLACE"
  client_secret: "tskey-REPLACE"
